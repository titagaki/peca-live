# ブラウザが動画を取りに行く PeerCast ノードの公開アドレス (host:port)。<meta name="peercast-tip"> でフロントに渡す
PEERCAST_TIP=localhost:7144
# Rails から PeerCast ノードへの JSON-RPC 接続先
PEERCAST_RPC_URL=http://localhost:7144/api/1
# 上記の Basic 認証 (base64("user:pass"))。peercast-mi の admin_user / admin_pass
PEERCAST_BASIC_TOKEN=
# チャンネル一覧を取得する YP。「名前=index.txtのURL」を空白区切りで
YELLOW_PAGES=SP=http://bayonet.ddo.jp:7146/index.txt TP=http://temp.orz.hm:7144/index.txt
# Docker (production) で必要。`openssl rand -hex 64` などで生成
SECRET_KEY_BASE=
